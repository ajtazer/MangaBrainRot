    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const msg = item.json.message || {};\n  const photos = msg.photo || [];\n\n  const text =\n    msg.from?.first_name ||\n    item.json.text ||\n    \"\";\n\n  // Largest Telegram image\n  const p = photos[photos.length - 1] || {};\n  const width = p.width || 1024;\n  const height = p.height || 1024;\n\n  /* ---------- FONT SIZE (RESPONSIVE) ---------- */\n  let fontSize = Math.round(width * 0.10);\n  fontSize = Math.max(32, Math.min(fontSize, 260));\n\n  /* ---------- TEXT WIDTH ESTIMATION ---------- */\n  // Avg character width ≈ 0.6 × fontSize (works well for bold fonts)\n  const avgCharWidth = fontSize * 0.6;\n  const maxLineLength = 80;\n  const longestLineChars = Math.min(text.length, maxLineLength);\n  const textWidth = longestLineChars * avgCharWidth;\n\n  /* ---------- X CENTER (PIXELS) ---------- */\n  let xOffset = Math.round((width / 2) - (textWidth / 2));\n  xOffset = Math.max(0, xOffset);\n\n  /* ---------- MULTILINE HEIGHT ---------- */\n  const lines = Math.max(1, Math.ceil(text.length / maxLineLength));\n  const lineHeight = fontSize * 1.2;\n  const textHeight = lines * lineHeight;\n\n  /* ---------- Y CENTER (PIXELS) ---------- */\n  let yOffset = Math.round((height / 2) - (textHeight / 2));\n  yOffset = Math.max(0, yOffset);\n\n  item.json._editText = {\n    fontSize,\n    xOffset,\n    yOffset\n  };\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
