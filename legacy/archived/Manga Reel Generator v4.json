    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst m = raw.match(/data:\\s*\\[([^\\]]+)\\]/g);\nif (m && m.length) {\n  const p = JSON.parse(m[m.length-1].replace('data: ',''));\n  const v = p[1];\n  const s = p[0] || '';\n  const tm = s.match(/Done!\\s*(.+?)\\s*-\\s*Ch\\./i);\n  const cm = s.match(/Ch\\.?(\\d+)/i);\n  return [{json: {\n    status: s,\n    mangaTitle: tm ? tm[1].trim() : 'Manga',\n    chapterNum: cm ? cm[1] : '',\n    let videoUrl = (typeof v === 'string') ? v : (v?.video?.url || v?.url || '')); return [{json: { status: s, mangaTitle: tm ? tm[1].trim() : 'Manga', chapterNum: cm ? cm[1] : ''', video_url: videoUrl,\n    chatId: $('Extract Chapter ID').first().json.chatId,\n    bgmName: $('Extract Chapter ID').first().json.bgmName\n  }}];\n}\nreturn [{json: {error: 'Parse failed', chatId: $('Extract Chapter ID').first().json.chatId}}];"
      },
