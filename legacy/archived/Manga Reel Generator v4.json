      "parameters": {
        "jsCode": "const message = $input.first().json.message.text;\nconst match = message.match(/mangadex\\.org\\/chapter\\/([a-f0-9-]+)/i);\n\nif (!match) throw new Error('Could not extract chapter ID');\n\n// --- BGM LIBRARY (all tracks) ---\nconst allBgmTracks = [\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/hype1_imagination.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/hype2_sakura_mitsutsuki.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/hype3_gurenge.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/hype4_kick_back.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/hype5_kaikai_kitan.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/love1_ai_no_scenario.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/love2_pride_kakumei.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/sad1_dakara_boku.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/sad2_ref_rain.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/sad3_yukitoki.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/sad4_kataomoi.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/chill1_hitchcock.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/chill2_vidro_moyou.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/chill3_sparkle.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/epic1_barricades.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/epic2_homura.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/epic3_boy.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/epic4_tot_musica.mp3\",\n  \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/bgm/Banda%20Kaam%20Ka%20pagalall.com.mp3\"\n];\n\n// Random BGM selection\nconst bgmUrl = allBgmTracks[Math.floor(Math.random() * allBgmTracks.length)];\nconst bgmName = bgmUrl.split('/').pop().replace('.mp3','').replace(/%20/g,' ');\nconst outroUrl = \"https://pub-3edc2a55a5af4b14b554c8ed89ceadb7.r2.dev/outro.jpg\";\n\nreturn [{\n  json: {\n    chapterId: match[1],\n    chatId: String($input.first().json.message.chat.id),\n    bgmUrl: bgmUrl,\n    bgmName: bgmName,\n    outroUrl: outroUrl\n  }\n}];"
      },
